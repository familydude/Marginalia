# Copy this file to .env and fill it in:  cp .env.example .env

# The password for the sign-in page. Use something long; a few random words works well.
MARGINALIA_PASSWORD=change-me-to-something-long

# Your user and group ids on the host (run `id -u` and `id -g`), so ./data stays yours.
UID=1000
GID=1000

# Your time zone, so "words today" rolls over at your midnight.
TZ=Europe/Stockholm

# Only if you put Marginalia behind a reverse proxy (Caddy, nginx, Traefik) that adds
# X-Forwarded-* headers. Enables correct client IPs and Secure cookies over HTTPS.
# TRUST_PROXY=1

# Secure cookies: auto (default: when served over HTTPS), true, or false.
# COOKIE_SECURE=auto
